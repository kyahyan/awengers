                <instance_material symbol="fenglongZS2-material" target="#fenglongZS2-material">
                  <bind_vertex_input semantic="UV0" input_semantic="TEXCOORD" input_set="0"/>
                </instance_material>
              </technique_common>
            </bind_material>
          </instance_controller>
        </node>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
